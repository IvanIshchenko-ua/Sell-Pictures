# Domain and CORS
CORS_ORIGIN=https://example.com

# RDS
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_PORT=3306
DB_USER=app_user
DB_PASSWORD=replace_with_strong_password
DB_NAME=art_shop

# Security
JWT_SECRET=replace_with_min_24_characters_secret
REQUEST_JSON_LIMIT=100kb
MAX_UPLOAD_SIZE_BYTES=5242880
GLOBAL_RATE_LIMIT_WINDOW_MS=900000
GLOBAL_RATE_LIMIT_MAX=250
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
AUTH_LOCKOUT_WINDOW_MS=900000
AUTH_LOCKOUT_MAX_FAILURES=5
AUTH_LOCKOUT_DURATION_MS=1800000
ORDER_RATE_LIMIT_WINDOW_MS=300000
ORDER_RATE_LIMIT_MAX=20
REQUEST_TIMEOUT_MS=15000
HEADERS_TIMEOUT_MS=10000
KEEP_ALIVE_TIMEOUT_MS=5000

# Optional image tags if using registry images
# BACKEND_IMAGE=ghcr.io/<owner>/sell-pictures-backend:latest
# FRONTEND_IMAGE=ghcr.io/<owner>/sell-pictures-frontend:latest
